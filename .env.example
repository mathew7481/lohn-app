# Allgemein
# Pfade sind plattformunabhängig: /, \\, ~ sowie Umgebungsvariablen (%USERPROFILE% / $HOME) sind möglich.
SCAN_ROOT_PATH=~/lohn/scanordner
ARCHIVE_PATH=~/lohn/scanordner/Archiv
FILE_PATTERN=.*?-(\d{6})-.*\.pdf

# Mailer
SIGNATURE_HTML_PATH=~/lohn/signatur/Signatur.html
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=mail@example.com
SMTP_PASSWORD=mein-smtp-passwort
SMTP_USE_STARTTLS=true
EMAIL_SUBJECT_TEMPLATE=Ihre Entgeltabrechnung{periode}
EMAIL_TEXT_FALLBACK=Hallo {name},\n\nim Anhang findest du deine Entgeltabrechnung{periode}.\n\nViele Grüße

# Kopie an LexOffice (optional)
LEXOFFICE_EMAIL=lexoffice@hv-niklas.com

# PostgreSQL
DB_NAME=gehaelter
DB_USER=postgres
DB_PASSWORD=mein-passwort
DB_HOST=127.0.0.1
DB_PORT=5432

# SSH-Tunnel (optional)
USE_SSH_TUNNEL=false
SSH_HOST=mein-ssh-host
SSH_PORT=22
SSH_USER=mein-ssh-user
SSH_PASSWORD=
SSH_PKEY=
SSH_PKEY_PASSWORD=
SSH_REMOTE_BIND_HOST=127.0.0.1
SSH_REMOTE_BIND_PORT=5432
SSH_LOCAL_BIND_HOST=127.0.0.1
SSH_LOCAL_BIND_PORT=0

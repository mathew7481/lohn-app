# scanner.py
# Basispfad ist immer der aktuelle Arbeitsordner; Archiv liegt unter ./Archiv

# Optional: SSH-Tunnel für scanner.py + mailer.py (Key-basiert)
SSH_TUNNEL_AKTIV=true
SSH_HOST=app2.example.com
SSH_BENUTZER=pguser
SSH_KEY_PFAD=$env:USERPROFILE\.ssh\id_pguser
SSH_LOCAL_PORT=5432
SSH_ZIEL_HOST=10.20.30.11
SSH_ZIEL_PORT=5432
SSH_SERVER_ALIVE_INTERVAL=60
SSH_SERVER_ALIVE_COUNT_MAX=3

# mailer.py
SIGNATUR_HTML_PFAD=/pfad/zur/signatur.html
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_BENUTZER=benutzer@example.com
SMTP_PASSWORT=bitte_setzen

# PostgreSQL (scanner.py + mailer.py)
DB_NAME=dbname
DB_USER=dbuser
DB_PASSWORD=bitte_setzen
DB_HOST=localhost
DB_PORT=5432

# Optional (mailer.py)
EMAIL_BETREFF=Ihre Entgeltabrechnung{periode}